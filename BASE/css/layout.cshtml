<!DOCTYPE html>
<html lang="pt-br">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - HardReserve</title>
    
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
</head>
<body class="site-container">

    <header class="main-header">
        <nav class="navbar">
            <div class="nav-logo">
                <a asp-area="" asp-controller="Home" asp-action="Index">
                    <img src="~/images/logo.png" alt="HardReserve Logo" />
                    <span>HardReserve</span>
                </a>
            </div>
            <ul class="nav-links">
                <li><a asp-controller="Acervo" asp-action="Index">Nosso acervo</a></li>
                <li><a asp-controller="Home" asp-action="QuemSomos">Quem somos</a></li>
                <li><a asp-controller="Account" asp-action="Login" class="btn-login">Login</a></li>
            </ul>
        </nav>
    </header>

    <main role="main" class="main-content">
        @RenderBody()
    </main>

    <footer class="main-footer">
        <div class="footer-top">
            <div class="footer-brand-section">
                <div class="footer-logos">
                    <img src="~/images/logo.png" alt="HardReserve" class="footer-logo-hr" />
                    <img src="~/images/logo-senai.png" alt="SENAI" class="footer-logo-senai" />
                </div>
                @* <p class="footer-handle">@hardreserve</p> *@
            </div>

            <div class="footer-links-column">
                <h3>HardReserve</h3>
                <ul>
                    <li><a href="#">Baixar aplicativo</a></li>
                    <li><a href="#">Suporte ao Usuário</a></li>
                </ul>
            </div>

            <div class="footer-links-column">
                <h3>Quem somos</h3>
                <ul>
                    <li><a href="#">Clientes</a></li>
                    <li><a href="#">Benefícios</a></li>
                </ul>
                
                <div class="footer-socials">
                    <h4>Siga nas redes sociais</h4>
                    <div class="social-icons">
                        <a href="#"><i class="bi bi-instagram"></i></a>
                        <a href="#"><i class="bi bi-facebook"></i></a>
                        <a href="#"><i class="bi bi-whatsapp"></i></a>
                    </div>
                </div>
            </div>
        </div>

        <hr class="footer-divider" />

        <div class="footer-bottom">
            <div class="footer-legal">
                <a href="#">Acessibilidade</a>
                <a href="#">Política de privacidade</a>
                <a href="#">Termos de condições</a>
            </div>
        </div>
    </footer>

    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>