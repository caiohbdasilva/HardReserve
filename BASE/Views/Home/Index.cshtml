@{
    ViewData["Title"] = "Página Inicial";
}

<section class="hero-section">
    <div class="hero-container">
        
        <div class="hero-content">
            <h1 class="hero-title">
                Bem-vindo ao<br />
                <span class="highlight-text">HardReserve</span>
            </h1>
            
            <p class="hero-description">
                O melhor lugar para fazer sua reserva de hardwares de maneira moderna e automatizada!
            </p>
            
            <div class="hero-buttons">
                <a asp-controller="Reserva" asp-action="Criar" class="btn-hero btn-primary">Reservar agora</a>
                <a asp-controller="Acervo" asp-action="Index" class="btn-hero btn-secondary">Verificar disponibilidade</a>
            </div>
        </div>

        <div class="hero-image-wrapper">
            <img src="~/images/hero-hardware.png" alt="Equipamentos de Hardware (Monitor, Teclado e Mouse)" class="hero-hardware-img" />
        </div>

    </div>
</section>