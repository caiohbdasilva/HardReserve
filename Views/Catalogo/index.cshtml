@* <!DOCTYPE html>
<html lang="pt-br">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Cadastrar Hardware - HardReserve</title>
    
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=Orbitron:wght@400;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="css/site.css" />

</head>

<body>
<main>
        <div class="container py-5" style="max-width: 1200px;">
            <h1 class="page-title text-white">Cadastrar hardware</h1>
    
            <form action="#" method="post" enctype="multipart/form-data">
                <div class="row g-4">
                    
                    <div class="col-lg-4">
                        <div class="cyber-card h-100 d-flex flex-column">
                            <h3 class="section-subtitle" style="font-size: 1rem; font-family: 'Orbitron';">Imagem do Hardware</h3>
                            
                            <label for="FotoHardware" class="image-upload-container my-auto">
                                <i class="bi bi-image upload-icon"></i>
                                <span class="upload-text">Clique para selecionar ou arraste a imagem do componente aqui</span>
                                <span class="text small mt-1">(PNG, JPG até 5MB)</span>
                            </label>
                            <input type="file" id="FotoHardware" name="FotoHardware" class="hidden-file-input" accept="image/*">
                        </div>
                    </div>
    
                    <div class="col-lg-8">
                        <div class="cyber-card h-100 d-flex flex-column justify-content-between">
                            
                            <div>
                                <h3 class="section-subtitle">Informações do Ativo</h3>
                                
                                <div class="form-group mb-4">
                                    <label for="NomeHardware"><i class="bi bi-cpu"></i> Nome do Hardware</label>
                                    <input type="text" id="NomeHardware" name="NomeHardware" placeholder="Ex: ESP-32 DevKit, Sensor Ultrassônico HC-SR04" required>
                                </div>
    
                                <div class="row g-3 mb-4">
                                    <div class="col-md-6 form-group">
                                        <label for="Quantidade"><i class="bi bi-hash"></i> Qntd. Disponível</label>
                                        <input type="number" id="Quantidade" name="Quantidade" placeholder="0" min="0" required>
                                    </div>
                                    <div class="col-md-6 form-group">
                                        <label for="Categoria"><i class="bi bi-tags"></i> Categoria</label>
                                        <select id="Categoria" name="Categoria" required>
                                            <option value="">Selecione uma categoria</option>
                                            <option value="microcontroladores">Microcontroladores</option>
                                            <option value="sensores">Sensores</option>
                                            <option value="atuadores">Atuadores / Motores</option>
                                            <option value="ferramentas">Ferramentas de Bancada</option>
                                            <option value="kits">Kits de Desenvolvimento</option>
                                            <option value="outros">Outros</option>
                                        </select>
                                    </div>
                                </div>
    
                                <div class="row g-3 mb-4">
                                    <div class="col-md-6 form-group">
                                        <label for="Status"><i class="bi bi-activity"></i> Status Inicial</label>
                                        <select id="Status" name="Status" required>
                                            <option value="disponivel">Disponível para Reserva</option>
                                            <option value="manutencao">Em Manutenção</option>
                                            <option value="indisponivel">Indisponível</option>
                                        </select>
                                    </div>
                                    <div class="col-md-6 form-group">
                                        <label for="CodigoPatrimonio"><i class="bi bi-barcode"></i> Cód. Patrimônio / ID (Opcional)</label>
                                        <input type="text" id="CodigoPatrimonio" name="CodigoPatrimonio" placeholder="Ex: HARD-2026-05">
                                    </div>
                                </div>
    
                                <div class="form-group mb-4">
                                    <label for="Descricao"><i class="bi bi-file-earmark-text"></i> Descrição / Especificações Técnicas</label>
                                    <textarea id="Descricao" name="Descricao" rows="4" placeholder="Descreva os detalhes do hardware, conexões, pinagem ou recomendações de uso..." required></textarea>
                                </div>
                            </div>
    
                            <div class="d-flex justify-content-end gap-3 mt-4 pt-3" style="border-top: 1px solid rgba(0, 255, 204, 0.1);">
                                <button type="button" class="btn-cyber-cancel btn-orbitron">Cancelar</button>
                                <button type="submit" class="btn-cyber-confirm btn-orbitron">Salvar Cadastro</button>
                            </div>
    
                        </div>
                    </div>
                </div>
            </form>
        </div>
</main>

</body>
</html> *@