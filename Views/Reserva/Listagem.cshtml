@model IEnumerable<HardReserve.Models.Reserva>

@{
    ViewData["Title"] = "Minhas Reservas";

    var ehTecnico = Context.Session.GetString("UsuarioRole") == "T";

    string StatusTexto(string s) => s switch
    {
        "PE" => "Pendente",
        "AP" => "Aprovado",
        "CA" => "Cancelado",
        "RE" => "Retirada",
        "DE" => "Devolvida",
        "AT" => "Atrasada",
        _    => s
    };
}

<div class="container py-5" style="max-width: 1100px;">

    <div class="d-flex justify-content-between align-items-center" style="margin-bottom:25px; flex-wrap:wrap; gap:12px;">
        <h1 class="page-title text-white" style="margin:0;">Reservas</h1>
        <a asp-action="Criar" class="btn-cyber-confirm btn-orbitron">
            <i class="bi bi-plus-lg"></i> Nova Reserva
        </a>
    </div>

    @if (!Model.Any())
    {
        <div class="cyber-card" style="text-align:center; padding:50px 20px;">
            <i class="bi bi-calendar-x" style="font-size:3rem; color:#00ffcc;"></i>
            <h3 class="text-white" style="margin-top:16px;">Nenhuma reserva por aqui ainda</h3>
            <p class="text-muted" style="margin-bottom:20px;">Que tal reservar seu primeiro equipamento?</p>
            <a asp-action="Criar" class="btn-cyber-confirm btn-orbitron" style="display:inline-block;">
                Fazer uma reserva
            </a>
        </div>
    }
    else
    {
        <div class="cyber-card" style="padding:0; overflow:hidden;">
            <div style="overflow-x:auto;">
                <table class="comprovante-tabela" style="font-size:0.9rem;">
                    <thead>
                        <tr>
                            <th style="padding:14px 16px;">Protocolo</th>
                            <th style="padding:14px 16px;">Solicitante</th>
                            <th style="padding:14px 16px;">Retirada</th>
                            <th style="padding:14px 16px;">Devolução</th>
                            <th style="padding:14px 16px;">Itens</th>
                            <th style="padding:14px 16px;">Status</th>
                            <th style="padding:14px 16px;"></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var reserva in Model)
                        {
                            <tr>
                                <td style="padding:14px 16px; font-family:'Orbitron',sans-serif; color:#00ffcc;">@reserva.Protocolo</td>
                                <td style="padding:14px 16px;">@(reserva.Usuario?.Nome ?? "—")</td>
                                <td style="padding:14px 16px;">@reserva.DataInicial.ToString("dd/MM/yy HH:mm")</td>
                                <td style="padding:14px 16px;">@reserva.DataFinal.ToString("dd/MM/yy HH:mm")</td>
                                <td style="padding:14px 16px;">@reserva.Quantidade</td>
                                <td style="padding:14px 16px;">
                                    <span class="comprovante-status status-@reserva.StatusReserva">@StatusTexto(reserva.StatusReserva)</span>
                                </td>
                                <td style="padding:14px 16px;">
                                    <div style="display:flex; gap:6px; align-items:center;">
                                        <a asp-action="Comprovante" asp-route-id="@reserva.Id"
                                           class="btn-add-carrinho" title="Ver comprovante" style="text-decoration:none;">
                                            <i class="bi bi-eye"></i>
                                        </a>
                                        @if (ehTecnico)
                                        {
                                            if (reserva.StatusReserva == "PE")
                                            {
                                                <button type="button" class="btn-status-acao acao-aprovar" title="Aprovar"
                                                        data-id="@reserva.Id" data-status="AP" data-label="aprovar esta reserva">
                                                    <i class="bi bi-check-lg"></i>
                                                </button>
                                                <button type="button" class="btn-status-acao acao-cancelar" title="Cancelar"
                                                        data-id="@reserva.Id" data-status="CA" data-label="cancelar esta reserva">
                                                    <i class="bi bi-x-lg"></i>
                                                </button>
                                            }
                                            else if (reserva.StatusReserva == "AP")
                                            {
                                                <button type="button" class="btn-status-acao acao-retirar" title="Registrar retirada"
                                                        data-id="@reserva.Id" data-status="RE" data-label="registrar a retirada deste equipamento">
                                                    <i class="bi bi-box-arrow-up"></i>
                                                </button>
                                                <button type="button" class="btn-status-acao acao-cancelar" title="Cancelar"
                                                        data-id="@reserva.Id" data-status="CA" data-label="cancelar esta reserva">
                                                    <i class="bi bi-x-lg"></i>
                                                </button>
                                            }
                                            else if (reserva.StatusReserva == "RE" || reserva.StatusReserva == "AT")
                                            {
                                                <button type="button" class="btn-status-acao acao-devolver" title="Registrar devolução"
                                                        data-id="@reserva.Id" data-status="DE" data-label="registrar a devolução deste equipamento">
                                                    <i class="bi bi-box-arrow-in-down"></i>
                                                </button>
                                            }
                                        }
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>

        <form id="formStatus" asp-action="MudarStatus" method="post" style="display:none;">
            <input type="hidden" name="id" id="statusReservaId" />
            <input type="hidden" name="novoStatus" id="statusNovoValor" />
        </form>
    }
</div>

@section Scripts {
    <script>
        document.querySelectorAll('.btn-status-acao').forEach(function (botao) {
            botao.addEventListener('click', function () {
                var id = this.getAttribute('data-id');
                var status = this.getAttribute('data-status');
                var label = this.getAttribute('data-label');
                SwalCyber.fire({
                    title: 'Confirmar ação?',
                    text: 'Deseja ' + label + '?',
                    icon: 'question',
                    showCancelButton: true,
                    confirmButtonText: 'Sim, confirmar',
                    cancelButtonText: 'Cancelar'
                }).then(function (result) {
                    if (result.isConfirmed) {
                        document.getElementById('statusReservaId').value = id;
                        document.getElementById('statusNovoValor').value = status;
                        document.getElementById('formStatus').submit();
                    }
                });
            });
        });
    </script>
}
