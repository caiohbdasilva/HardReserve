@model IEnumerable<HardReserve.Models.Reserva>

@{
    ViewData["Title"] = "Listagem de Reservas";
}

<div class="container mt-5">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2>📋 Listagem de Reservas (Provisória)</h2>
        <a asp-action="Solicitar" class="btn btn-primary">
            Ir para Fazer Reserva
        </a>
    </div>

    <p class="text-muted">Aguardando o HTML definitivo da equipe. Os dados do banco já estão renderizando abaixo:</p>

    <div class="table-responsive">
        <table class="table table-striped table-bordered mt-3">
            <thead class="table-dark">
                <tr>
                    <th>ID</th>
                    <th>Data Inicial</th>
                    <th>Data Final</th>
                    <th>Quantidade</th>
                    <th>Status</th>
                </tr>
            </thead>
            <tbody>
                @if (Model != null && Model.Any())
                {
                    foreach (var reserva in Model)
                    {
                        <tr>
                            <td>@reserva.Id</td>
                            <td>@reserva.DataInicial.ToString("dd/MM/yyyy HH:mm")</td>
                            <td>@reserva.DataFinal.ToString("dd/MM/yyyy HH:mm")</td>
                            <td>@reserva.Quantidade</td>
                            <td>
                                <span class="badge @(reserva.StatusReserva == "PE" ? "bg-warning text-dark" : "bg-success")">
                                    @reserva.StatusReserva
                                </span>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="5" class="text-center text-muted py-4">
                            Nenhuma reserva encontrada no banco de dados.
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>