<div class="container mt-5 text-white">
    <h2>📅 Gerenciamento de Reservas</h2>
    <p class="text-muted">Gerencie seus agendamentos de equipamentos de hardware aqui.</p>

    <div class="card bg-dark border-secondary shadow-sm mt-4">
        <div class="card-header border-secondary d-flex justify-content-between align-items-center">
            <h4 class="mb-0 text-white">Seus Agendamentos</h4>
            <a asp-action="Criar" class="btn btn-success btn-sm">
                <i class="bi bi-calendar-plus"></i> Nova Reserva
            </a>
        </div>
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-dark table-striped table-hover align-middle mb-0">
                    <thead class="table-light text-dark">
                        <tr>
                            <th># ID</th>
                            <th>Usuário</th>
                            <th>Data Inicial</th>
                            <th>Data Final</th>
                            <th>Qtd. Itens</th>
                            <th>Status</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model != null && Model.Any())
                        {
                            foreach (var reserva in Model)
                            {
                                <tr>
                                    <td><strong>@reserva.Id</strong></td>
                                    <td>@reserva.Usuario?.Nome</td>
                                    <td>@reserva.DataInicial.ToString("dd/MM/yyyy HH:mm")</td>
                                    <td>@reserva.DataFinal.ToString("dd/MM/yyyy HH:mm")</td>
                                    <td><span class="badge bg-secondary">@reserva.Quantidade</span></td>
                                    <td>
                                        @if (reserva.StatusReserva == "PE")
                                        {
                                            <span class="badge bg-warning text-dark">Pendente</span>
                                        }
                                        else if (reserva.StatusReserva == "AP")
                                        {
                                            <span class="badge bg-success">Aprovada</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-danger">Finalizada</span>
                                        }
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="6" class="text-center py-5 text-muted">
                                    Nenhuma reserva cadastrada no sistema.
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>