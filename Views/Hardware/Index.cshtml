@model IEnumerable<HardReserve.Models.Hardware>

@{
    ViewData["Title"] = "Catálogo de Hardware";
}

<h2>Gerenciamento de Hardwares</h2>
<p>Listagem de equipamentos baseada na modelagem em andamento.</p>

<table class="table table-striped table-hover">
    <thead class="thead-dark">
        <tr>
            <th>ID</th>
            <th>Nome</th>
            <th>Descrição</th>
            <th>Quantidade Total</th>
            <th>Localização</th>
            <th>ID do Kit</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var hw in Model)
        {
            <tr>
                <td>@hw.Id</td>
                <td>@hw.Nome</td>
                <td>@hw.Descricao</td>
                <td>@hw.QuantidadeTotal</td>
                <td>@hw.Localizacao</td>
                <td>@(hw.KitId.HasValue ? hw.KitId.ToString() : "Avulso")</td>
            </tr>
        }
    </tbody>
</table>