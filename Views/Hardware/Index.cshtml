@using HardReserve.Models
@model IEnumerable<HardReserve.Models.Hardware>

@{
    ViewData["Title"] = "Catálogo de Hardware";
}
 <body>

  <!-- ══ NAVBAR ══ -->
  <nav class="navbar">
    <a href="#" class="navbar-brand">
      <div class="brand-icon"></div>
      <span class="brand-name">HardReserve</span>
    </a>

    <ul class="nav-links">
      <li><a href="#">Home</a></li>
      <li><a href="#" class="active">Catálogo</a></li>
      <li><a href="#">Reservas</a></li>
    </ul>

    <button class="btn-login">Login</button>
  </nav>

  <!-- ══ MAIN ══ -->
  <main class="page-wrapper">

    <!-- Título -->
    <div class="catalog-header-title">
      <h2>Catálogo de Hardwares</h2>
    </div>

    <!-- Barra de busca -->
    <div class="search-filter-bar">
      <div class="search-input-wrapper">
        <i class="bi bi-search search-icon-inside"></i>
        <input
          type="text"
          id="catalogSearch"
          class="input-tech padding-icon"
          placeholder="Pesquise..."
          onkeyup="filtrarCatalogo()"
        />
      </div>
      <div class="category-dropdown-wrapper">
        <select class="input-tech" id="categorySelect" onchange="filtrarCatalogo()">
          <option value="todos">Categorias</option>
          <option value="arduino">Arduino</option>
          <option value="esp32">ESP32</option>
          <option value="led">LEDs</option>
          <option value="cabos">Cabos e Fios</option>
          <option value="perifericos">Periféricos</option>
          <option value="impressoras">Impressoras 3D</option>
        </select>
      </div>
      <button class="wishlist-btn" title="Favoritos">
        <i class="bi bi-heart"></i>
      </button>
    </div>

    <!-- Grid layout -->
    <div class="catalog-layout-grid">

      <!-- ── Sidebar ── -->
      <aside class="filter-sidebar">
        <div class="filter-box-title">
          <h3>Filtros</h3>
        </div>
        <div class="filter-group-container">
          <div class="filter-category-toggle">
            <span>Categorias</span>
            <i class="bi bi-chevron-up" id="chevronIcon"></i>
          </div>
          <ul class="filter-list-items" id="filterList">
            <li><label><input type="checkbox" class="cat-checkbox" value="computadores" checked onchange="filtrarPorCheckbox()"> Computadores (20)</label></li>
            <li><label><input type="checkbox" class="cat-checkbox" value="arduino" checked onchange="filtrarPorCheckbox()"> Arduino (20)</label></li>
            <li><label><input type="checkbox" class="cat-checkbox" value="motores" checked onchange="filtrarPorCheckbox()"> Motores (20)</label></li>
            <li><label><input type="checkbox" class="cat-checkbox" value="perifericos" checked onchange="filtrarPorCheckbox()"> Periféricos (20)</label></li>
            <li><label><input type="checkbox" class="cat-checkbox" value="impressoras" checked onchange="filtrarPorCheckbox()"> Impressoras 3D (20)</label></li>
            <li><label><input type="checkbox" class="cat-checkbox" value="led" checked onchange="filtrarPorCheckbox()"> Leds (20)</label></li>
            <li><label><input type="checkbox" class="cat-checkbox" value="protoboards" checked onchange="filtrarPorCheckbox()"> Protoboards (20)</label></li>
            <li><label><input type="checkbox" class="cat-checkbox" value="cabos" checked onchange="filtrarPorCheckbox()"> Fios Jumpers (20)</label></li>
            <li><label><input type="checkbox" class="cat-checkbox" value="botoes" checked onchange="filtrarPorCheckbox()"> Botões (20)</label></li>
            <li><label><input type="checkbox" class="cat-checkbox" value="lcd" checked onchange="filtrarPorCheckbox()"> LCD (20)</label></li>
          </ul>
        </div>
        <div class="filter-legend">
          <div class="legend-item">
            <span class="legend-dot"></span>
            <span>Exemplo (20)</span>
          </div>
          <div class="legend-item">
            <span class="legend-dot grey"></span>
            <span>&nbsp;</span>
          </div>
        </div>
      </aside>

      <!-- ── Results ── -->
      <section class="catalog-results-area">

        <div class="results-counter" id="counterText">Exibindo 1-30 de 63 resultados</div>

        <div class="hardware-cards-grid" id="cardsGrid">

          <!-- Card 1 -->
          <div class="hw-card" data-nome="servo motor tower pro sg90 para arduino e robótica" data-categoria="motores">
            <div class="hw-badge-availability"><i class="bi bi-box-seam-fill"></i> 13 unidades disponíveis</div>
            <div class="hw-card-img-container">
              <img src="img/ServoMotor.png" alt="Servo Motor SG90" class="hw-hardware-asset-img" onerror="this.style.opacity='0'" />
            </div>
            <div class="hw-card-info">
              <h4>Servo Motor TOWER PRO SG90 para Arduino e Robótica</h4>
              <p class="hw-desc">O servo Motor é um dispositivo que ao receber comandos de controle, verifica a posição atual e se movimenta para a posição desejada com velocidade modulada.</p>
            </div>
            <div class="hw-card-actions">
              <button class="btn-qty">-</button>
              <button class="btn-reserve-icon"><i class="bi bi-box-seam"></i></button>
              <button class="btn-qty">+</button>
            </div>
          </div>

          <!-- Card 2 -->
          <div class="hw-card" data-nome="esp-32 devkit" data-categoria="esp32">
            <div class="hw-badge-availability"><i class="bi bi-box-seam-fill"></i> 13 unidades disponíveis</div>
            <div class="hw-card-img-container">
              <img src="img/Esp32.png" alt="ESP-32 DevKit" class="hw-hardware-asset-img" onerror="this.style.opacity='0'" />
            </div>
            <div class="hw-card-info">
              <h4>ESP-32 DevKit</h4>
              <p class="hw-desc">O ESP32 é uma placa de desenvolvimento, com alto poder de processamento e conectividade Wi-Fi e Bluetooth embutidas.</p>
            </div>
            <div class="hw-card-actions">
              <button class="btn-qty">-</button>
              <button class="btn-reserve-icon"><i class="bi bi-box-seam"></i></button>
              <button class="btn-qty">+</button>
            </div>
          </div>

          <!-- Card 3 -->
          <div class="hw-card" data-nome="headset gamer" data-categoria="perifericos">
            <div class="hw-badge-availability"><i class="bi bi-box-seam-fill"></i> 13 unidades disponíveis</div>
            <div class="hw-card-img-container">
              <img src="img/Headset.png" alt="Headset Gamer" class="hw-hardware-asset-img" onerror="this.style.opacity='0'" />
            </div>
            <div class="hw-card-info">
              <h4>Headset Gamer</h4>
              <p class="hw-desc">Áudio imersivo e microfone com cancelamento de ruído. Perfeito para videochamadas de equipe e sessões de jogo.</p>
            </div>
            <div class="hw-card-actions">
              <button class="btn-qty">-</button>
              <button class="btn-reserve-icon"><i class="bi bi-box-seam"></i></button>
              <button class="btn-qty">+</button>
            </div>
          </div>

          <!-- Card 4 -->
          <div class="hw-card" data-nome="mouse rgb" data-categoria="perifericos">
            <div class="hw-badge-availability"><i class="bi bi-box-seam-fill"></i> 13 unidades disponíveis</div>
            <div class="hw-card-img-container">
              <img src="img/Mouse.png" alt="Mouse RGB" class="hw-hardware-asset-img" onerror="this.style.opacity='0'" />
            </div>
            <div class="hw-card-info">
              <h4>Mouse RGB</h4>
              <p class="hw-desc">Controle preciso e ergonômico com iluminação RGB personalizável. Ideal para navegação e desenvolvimento de código.</p>
            </div>
            <div class="hw-card-actions">
              <button class="btn-qty">-</button>
              <button class="btn-reserve-icon"><i class="bi bi-box-seam"></i></button>
              <button class="btn-qty">+</button>
            </div>
          </div>

          <!-- Card 5 -->
          <div class="hw-card" data-nome="impressora 3d" data-categoria="impressoras">
            <div class="hw-badge-availability"><i class="bi bi-box-seam-fill"></i> 13 unidades disponíveis</div>
            <div class="hw-card-img-container">
              <img src="img/Impressora3D.png" alt="Impressora 3D" class="hw-hardware-asset-img" onerror="this.style.opacity='0'" />
            </div>
            <div class="hw-card-info">
              <h4>Impressora 3D</h4>
              <p class="hw-desc">A impressora 3D é um equipamento que cria objetos físicos tridimensionais a partir de um projeto digital.</p>
            </div>
            <div class="hw-card-actions">
              <button class="btn-qty">-</button>
              <button class="btn-reserve-icon"><i class="bi bi-box-seam"></i></button>
              <button class="btn-qty">+</button>
            </div>
          </div>

          <!-- Card 6 -->
          <div class="hw-card" data-nome="teclado compacto" data-categoria="perifericos">
            <div class="hw-badge-availability"><i class="bi bi-box-seam-fill"></i> 13 unidades disponíveis</div>
            <div class="hw-card-img-container">
              <img src="img/Teclado.png" alt="Teclado Compacto" class="hw-hardware-asset-img" onerror="this.style.opacity='0'" />
            </div>
            <div class="hw-card-info">
              <h4>Teclado Compacto</h4>
              <p class="hw-desc">Design minimalista e teclas macias para uma digitação confortável e eficiente durante horas de codificação.</p>
            </div>
            <div class="hw-card-actions">
              <button class="btn-qty">-</button>
              <button class="btn-reserve-icon"><i class="bi bi-box-seam"></i></button>
              <button class="btn-qty">+</button>
            </div>
          </div>

          <!-- Card 7 -->
          <div class="hw-card" data-nome="notebook" data-categoria="computadores">
            <div class="hw-badge-availability"><i class="bi bi-box-seam-fill"></i> 13 unidades disponíveis</div>
            <div class="hw-card-img-container">
              <img src="img/Notebook.png" alt="Notebook" class="hw-hardware-asset-img" onerror="this.style.opacity='0'" />
            </div>
            <div class="hw-card-info">
              <h4>Notebook</h4>
              <p class="hw-desc">Portátil e pronto para programação. Suporta Arduino Uno, Mega e sensores diversos. Tudo pronto para seus projetos de Internet das Coisas e Robótica Integrada.</p>
            </div>
            <div class="hw-card-actions">
              <button class="btn-qty">-</button>
              <button class="btn-reserve-icon"><i class="bi bi-box-seam"></i></button>
              <button class="btn-qty">+</button>
            </div>
          </div>

          <!-- Card 8 -->
          <div class="hw-card" data-nome="arduino uno" data-categoria="arduino">
            <div class="hw-badge-availability"><i class="bi bi-box-seam-fill"></i> 13 unidades disponíveis</div>
            <div class="hw-card-img-container">
              <img src="img/ArduinoUno.png" alt="Arduino Uno" class="hw-hardware-asset-img" onerror="this.style.opacity='0'" />
            </div>
            <div class="hw-card-info">
              <h4>Arduino Uno</h4>
              <p class="hw-desc">O Arduino Uno é uma placa de prototipagem eletrônica de código aberto. Na prática, ela funciona como um pequeno computador ou "cérebro" programável.</p>
            </div>
            <div class="hw-card-actions">
              <button class="btn-qty">-</button>
              <button class="btn-reserve-icon"><i class="bi bi-box-seam"></i></button>
              <button class="btn-qty">+</button>
            </div>
          </div>

          <!-- Card 9 -->
          <div class="hw-card" data-nome="botão de arduino" data-categoria="botoes">
            <div class="hw-badge-availability"><i class="bi bi-box-seam-fill"></i> 13 unidades disponíveis</div>
            <div class="hw-card-img-container">
              <img src="img/Botao.png" alt="Botão de Arduino" class="hw-hardware-asset-img" onerror="this.style.opacity='0'" />
            </div>
            <div class="hw-card-info">
              <h4>Botão de Arduino</h4>
              <p class="hw-desc">O botão é um interruptor momentâneo. Ele converte uma ação mecânica (o ato de apertar) em um sinal elétrico.</p>
            </div>
            <div class="hw-card-actions">
              <button class="btn-qty">-</button>
              <button class="btn-reserve-icon"><i class="bi bi-box-seam"></i></button>
              <button class="btn-qty">+</button>
            </div>
          </div>

          <!-- Card 10 -->
          <div class="hw-card" data-nome="leds rgb" data-categoria="led">
            <div class="hw-badge-availability"><i class="bi bi-box-seam-fill"></i> 13 unidades disponíveis</div>
            <div class="hw-card-img-container">
              <img src="img/LedVermelho.png" alt="Leds RGB" class="hw-hardware-asset-img" onerror="this.style.opacity='0'" />
            </div>
            <div class="hw-card-info">
              <h4>Leds RGB</h4>
              <p class="hw-desc">Led é um componente eletrônico que transforma energia elétrica em luz.</p>
            </div>
            <div class="hw-card-actions">
              <button class="btn-qty">-</button>
              <button class="btn-reserve-icon"><i class="bi bi-box-seam"></i></button>
              <button class="btn-qty">+</button>
            </div>
          </div>

          <!-- Card 11 -->
          <div class="hw-card" data-nome="protoboards" data-categoria="protoboards">
            <div class="hw-badge-availability"><i class="bi bi-box-seam-fill"></i> 13 unidades disponíveis</div>
            <div class="hw-card-img-container">
              <img src="img/Jumpers.png" alt="Protoboards" class="hw-hardware-asset-img" onerror="this.style.opacity='0'" />
            </div>
            <div class="hw-card-info">
              <h4>Protoboards</h4>
              <p class="hw-desc">Uma protoboard ou placa de ensaio é uma matriz de células reutilizáveis que permite montar circuitos eletrônicos temporários sem necessidade de solda.</p>
            </div>
            <div class="hw-card-actions">
              <button class="btn-qty">-</button>
              <button class="btn-reserve-icon"><i class="bi bi-box-seam"></i></button>
              <button class="btn-qty">+</button>
            </div>
          </div>

          <!-- Card 12 -->
          <div class="hw-card" data-nome="dht11 sensor de umidade" data-categoria="arduino">
            <div class="hw-badge-availability"><i class="bi bi-box-seam-fill"></i> 13 unidades disponíveis</div>
            <div class="hw-card-img-container">
              <img src="img/SensorSolo.png" alt="DHT11 Sensor de Umidade" class="hw-hardware-asset-img" onerror="this.style.opacity='0'" />
            </div>
            <div class="hw-card-info">
              <h4>DHT11 sensor de umidade</h4>
              <p class="hw-desc">O DHT11 é um dispositivo que mede a quantidade de vapor d'água no ar ou a umidade em materiais como solo e a madeira.</p>
            </div>
            <div class="hw-card-actions">
              <button class="btn-qty">-</button>
              <button class="btn-reserve-icon"><i class="bi bi-box-seam"></i></button>
              <button class="btn-qty">+</button>
            </div>
          </div>

          <!-- Card 13 -->
          <div class="hw-card" data-nome="fios jumper" data-categoria="cabos">
            <div class="hw-badge-availability"><i class="bi bi-box-seam-fill"></i> 13 unidades disponíveis</div>
            <div class="hw-card-img-container">
              <img src="img/CaboUsbC.png" alt="Fios Jumper" class="hw-hardware-asset-img" onerror="this.style.opacity='0'" />
            </div>
            <div class="hw-card-info">
              <h4>Fios Jumper</h4>
              <p class="hw-desc">Jumper é um pedaço de fio ou cabo condutor usado para conectar dois pontos elétricos distintos.</p>
            </div>
            <div class="hw-card-actions">
              <button class="btn-qty">-</button>
              <button class="btn-reserve-icon"><i class="bi bi-box-seam"></i></button>
              <button class="btn-qty">+</button>
            </div>
          </div>

          <!-- Card 14 -->
          <div class="hw-card" data-nome="sensor de distância ultrassônico hc-sr04" data-categoria="arduino">
            <div class="hw-badge-availability"><i class="bi bi-box-seam-fill"></i> 13 unidades disponíveis</div>
            <div class="hw-card-img-container">
              <img src="img/Ultrassonico.png" alt="Sensor Ultrassônico HC-SR04" class="hw-hardware-asset-img" onerror="this.style.opacity='0'" />
            </div>
            <div class="hw-card-info">
              <h4>Sensor De Distância Ultrassônico HC-SR04</h4>
              <p class="hw-desc">HC-sr04 é um dispositivo eletrônico que calcula a proximidade entre o sensor e um objeto.</p>
            </div>
            <div class="hw-card-actions">
              <button class="btn-qty">-</button>
              <button class="btn-reserve-icon"><i class="bi bi-box-seam"></i></button>
              <button class="btn-qty">+</button>
            </div>
          </div>

          <!-- Card 15 -->
          <div class="hw-card" data-nome="display lcd" data-categoria="lcd">
            <div class="hw-badge-availability"><i class="bi bi-box-seam-fill"></i> 13 unidades disponíveis</div>
            <div class="hw-card-img-container">
              <img src="img/DisplayOled.png" alt="Display LCD" class="hw-hardware-asset-img" onerror="this.style.opacity='0'" />
            </div>
            <div class="hw-card-info">
              <h4>Display Lcd</h4>
              <p class="hw-desc">Um LCD Arduino refere-se à integração de um display de cristal líquido (LCD) com a placa Arduino, permitindo que exiba informações como textos, números ou resultados de sensores.</p>
            </div>
            <div class="hw-card-actions">
              <button class="btn-qty">-</button>
              <button class="btn-reserve-icon"><i class="bi bi-box-seam"></i></button>
              <button class="btn-qty">+</button>
            </div>
          </div>

        </div><!-- /hardware-cards-grid -->

        <!-- Paginação -->
        <div class="pagination-container">
          <span class="pag-arrow"><i class="bi bi-chevron-left"></i></span>
          <span class="pag-num active">1</span>
          <span class="pag-num">2</span>
          <div class="pag-group">
            <span class="pag-num active">3</span>
            <span class="pag-num">4</span>
          </div>
          <span class="pag-num">5</span>
          <span class="pag-num">6</span>
          <span class="pag-arrow"><i class="bi bi-chevron-right"></i></span>
        </div>

      </section>
    </div><!-- /catalog-layout-grid -->

  </main>

  <!-- ══ FOOTER ══ -->


</body>