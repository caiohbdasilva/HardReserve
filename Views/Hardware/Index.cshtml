@using HardReserve.Models
@model IEnumerable<HardReserve.Models.Hardware>

@{
    ViewData["Title"] = "Catálogo de Hardware";
}

<h2>Catálogo de Hardwares</h2>
<p>Listagem de equipamentos baseada no banco de dados.</p>

<div class="container mt-5">
    <div class="card shadow-sm">
        <div class="card-header bg-dark text-white d-flex justify-content-between align-items-center">
            <h4 class="mb-0">Inventário de Componentes e Hardwares</h4>
            <a asp-action="Create" class="btn btn-success btn-sm">
                <i class="bi bi-plus-circle"></i> Novo Hardware
            </a>
        </div>
        
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-striped table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th scope="col" class="ps-3" style="width: 80px;"># ID</th>
                            <th scope="col">Nome</th>
                            <th scope="col">Descrição</th>
                            <th scope="col" class="text-center">Qtd. Total</th>
                            <th scope="col">Localização</th>
                            <th scope="col" class="text-center">Vínculo</th>
                            <th scope="col" class="text-center" style="width: 150px;">Ações</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model != null && Model.Any())
                        {
                            foreach (var hardware in Model)
                            {
                                <tr>
                                    <td class="ps-3"><strong>@hardware.Id</strong></td>
                                    
                                    <td><span class="fw-semibold text-secondary">@hardware.Nome</span></td>
                                    
                                    <td>
                                        @if (!string.IsNullOrEmpty(hardware.Descricao))
                                        {
                                            @hardware.Descricao
                                        }
                                        else
                                        {
                                            <span class="text-muted italic-text">Sem descrição</span>
                                        }
                                    </td>
                                    
                                    <td class="text-center">
                                        <span class="badge bg-secondary px-3 py-2">@hardware.Quantidade_Total</span>
                                    </td>
                                    
                                    <td>
                                        @(hardware.Localizacao ?? "Não informada")
                                    </td>
                                    
                                    <td class="text-center">
                                        @if (hardware.Kit_Id.HasValue)
                                        {
                                            <span class="badge bg-info text-dark">Kit #@hardware.Kit_Id</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-light text-muted border">Avulso</span>
                                        }
                                    </td>
                                    
                                    <td class="text-center pe-3">
                                        <div class="btn-group btn-group-sm" role="group">
                                            <a asp-action="Edit" asp-route-id="@hardware.Id" class="btn btn-outline-primary" title="Editar">Editar</a>
                                            <a asp-action="Details" asp-route-id="@hardware.Id" class="btn btn-outline-secondary" title="Detalhes">Info</a>
                                        </div>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="7" class="text-center py-5 text-muted">
                                    <i class="bi bi-box-seam d-block fs-2 mb-2"></i>
                                    Nenhum hardware cadastrado no inventário.
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>