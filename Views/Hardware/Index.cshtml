@model IEnumerable<HardReserve.Models.Hardware>

@{
    ViewData["Title"] = "Catálogo de Hardwares";

    var ehTecnico = Context.Session.GetString("UsuarioRole") == "T";

    var categorias = Model
        .Where(h => !string.IsNullOrEmpty(h.Categoria))
        .Select(h => h.Categoria!)
        .Distinct()
        .OrderBy(c => c)
        .ToList();

    string StatusTexto(string s) => s switch
    {
        "disponivel"   => "Disponível",
        "manutencao"   => "Em Manutenção",
        "indisponivel" => "Indisponível",
        _              => s
    };
}

<div class="container py-5" style="max-width: 1200px;">

    <div class="catalog-header-title">
        <h1 class="page-title text-white">Catálogo de Hardwares</h1>
    </div>

    <div class="search-filter-bar">
        <div class="search-input-wrapper">
            <input type="text" id="catalogSearch" class="input-tech"
                   placeholder="Pesquise pelo nome do hardware..." onkeyup="filtrarCatalogo()" />
        </div>
        <div class="category-dropdown-wrapper">
            <select class="input-tech" id="categorySelect" onchange="filtrarCatalogo()">
                <option value="todos">Todas as categorias</option>
                @foreach (var cat in categorias)
                {
                    <option value="@cat">@cat</option>
                }
            </select>
        </div>
    </div>

    @if (!Model.Any())
    {

        <div class="cyber-card" style="text-align:center; padding:60px 20px;">
            <i class="bi bi-box-seam" style="font-size:3.5rem; color:#00ffcc;"></i>
            <h3 class="text-white" style="margin-top:18px;">Nenhum hardware cadastrado ainda</h3>
            <p class="text-muted" style="margin-bottom:22px;">
                Assim que um equipamento for cadastrado, ele aparece aqui no catálogo.
            </p>
            <a asp-action="Cadastrar" class="btn-cyber-confirm btn-orbitron"
               style="display:inline-block; padding:12px 28px;">
                <i class="bi bi-plus-lg"></i> Cadastrar primeiro hardware
            </a>
        </div>
    }
    else
    {
        <div class="results-counter" id="counterText">
            Exibindo <strong>@Model.Count()</strong> hardware(s)
        </div>

        <div class="hardware-cards-grid" id="cardsGrid">
            @foreach (var hw in Model)
            {
                <div class="hw-card"
                     data-nome="@hw.Nome.ToLower()"
                     data-categoria="@hw.Categoria">

                    <span class="hw-status-badge status-@hw.Status">
                        <i class="bi bi-circle-fill"></i> @StatusTexto(hw.Status)
                    </span>

                    <div class="hw-card-img-container">
                        @if (!string.IsNullOrEmpty(hw.Imagem))
                        {
                            <img src="@Url.Content("~/" + hw.Imagem)" alt="@hw.Nome" class="hw-hardware-asset-img"
                                 onerror="this.style.display='none'; this.nextElementSibling.style.display='block';" />
                            <i class="bi bi-cpu hw-img-fallback" style="display:none;"></i>
                        }
                        else
                        {
                            <i class="bi bi-cpu hw-img-fallback"></i>
                        }
                    </div>

                    <div class="hw-card-info">
                        <h4>@hw.Nome</h4>
                        <p class="hw-desc">@hw.Descricao</p>
                        <p class="hw-qtd">
                            <i class="bi bi-box-seam-fill"></i> @hw.QuantidadeDisponivel de @hw.Quantidade_Total disponível(is)
                        </p>
                        @if (!string.IsNullOrEmpty(hw.Localizacao))
                        {
                            <p class="hw-loc"><i class="bi bi-geo-alt"></i> @hw.Localizacao</p>
                        }
                    </div>

                    <div class="hw-card-actions">
                        @if (ehTecnico)
                        {
                            <a asp-action="Editar" asp-route-id="@hw.Id" class="btn-tech-action btn-tech-edit">
                                <i class="bi bi-pencil-square"></i> Editar
                            </a>
                            <form asp-action="Excluir" asp-route-id="@hw.Id" method="post" class="form-excluir">
                                <button type="button" class="btn-tech-action btn-tech-delete btn-excluir-hw">
                                    <i class="bi bi-trash"></i> Excluir
                                </button>
                            </form>
                        }
                        else
                        {
                            <a asp-controller="Reserva" asp-action="Criar" asp-route-hardwareId="@hw.Id" class="btn-tech-action">
                                <i class="bi bi-calendar-plus"></i> Reservar
                            </a>
                        }
                    </div>
                </div>
            }
        </div>

        <div id="semResultados" class="text-muted" style="display:none; text-align:center; padding:40px;">
            <i class="bi bi-search" style="font-size:2rem;"></i>
            <p style="margin-top:10px;">Nenhum hardware encontrado para a sua busca.</p>
        </div>
    }
</div>

@section Scripts {
    <script>
        function filtrarCatalogo() {
            const termo = (document.getElementById('catalogSearch')?.value || '').toLowerCase();
            const categoria = document.getElementById('categorySelect')?.value || 'todos';
            const cards = document.querySelectorAll('#cardsGrid .hw-card');
            let visiveis = 0;

            cards.forEach(function (card) {
                const nome = card.getAttribute('data-nome') || '';
                const cat = card.getAttribute('data-categoria') || '';

                const bateNome = nome.includes(termo);
                const bateCategoria = (categoria === 'todos') || (cat === categoria);

                if (bateNome && bateCategoria) {
                    card.style.display = '';
                    visiveis++;
                } else {
                    card.style.display = 'none';
                }
            });

            const counter = document.getElementById('counterText');
            if (counter) counter.innerHTML = 'Exibindo <strong>' + visiveis + '</strong> hardware(s)';

            const semResultados = document.getElementById('semResultados');
            if (semResultados) semResultados.style.display = visiveis === 0 ? 'block' : 'none';
        }

        document.querySelectorAll('.btn-excluir-hw').forEach(function (botao) {
            botao.addEventListener('click', function () {
                var form = this.closest('form');
                SwalCyber.fire({
                    title: 'Tem certeza?',
                    text: 'Esta ação não pode ser desfeita e o hardware será removido do catálogo.',
                    icon: 'warning',
                    showCancelButton: true,
                    confirmButtonText: 'Sim, excluir',
                    cancelButtonText: 'Cancelar'
                }).then(function (result) {
                    if (result.isConfirmed) {
                        form.submit();
                    }
                });
            });
        });
    </script>
}
