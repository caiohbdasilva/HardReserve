@{
    ViewData["Title"] = "Login";
}

<form asp-controller="Usuario" asp-action="Logar" method="post" class="login-page-container">
    <div class="login-card">
        <div class="login-logo-wrapper">
            <img src="~/img/HardwareReserve.svg.png" alt="Icone HardReserve" class="login-card-icon" />
            <h1 class="login-card-title">HardReserve</h1>
        </div>

        <div class="login-form">
            <div class="form-group">
                <label for="Email">Email</label>
                <input type="email" id="Email" name="email" required autocomplete="username" />
            </div>

            <div class="form-group">
                <label for="Senha">Senha</label>
                <input type="password" id="Senha" name="senha" required autocomplete="current-password" />
            </div>

            <button type="submit" class="btn-submit-login">Entrar</button>
        </div>
    </div>
</form>
