@if (TempData["Erro"] != null)
{
    <div class="alert alert-danger" role="alert">
        @TempData["Erro"]
    </div>
}

<form asp-controller="Usuario" asp-action="Logar" method="POST">
  
  <div class="form-group">
    <label for="InputEmail">Endereço de E-mail</label>
    <input type="email" name="email" class="form-control" id="InputEmail" placeholder="exemplo@senai.br" required>
    <small id="emailHelp" class="form-text text-muted">Use o seu e-mail institucional cadastrado.</small>
  </div>
  
  <div class="form-group">
    <label for="InputPassword">Senha</label>
    <input type="password" name="senha" class="form-control" id="InputPassword" placeholder="Digite sua senha" required>
  </div>
  
  <button type="submit" class="btn btn-primary w-100">Entrar</button>
</form>