<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - HardReserve</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=Orbitron:wght@400;700&display=swap" rel="stylesheet">

    <link rel="stylesheet" href="~/HardReserve.styles.css" asp-append-version="true" />
</head>
<body>
@{
    var usuarioId   = Context.Session.GetString("UsuarioId");
    var usuarioRole = Context.Session.GetString("UsuarioRole");
    var estaLogado  = !string.IsNullOrEmpty(usuarioId);
    var ehTecnico   = usuarioRole == "T";
}
<header>
    <nav class="navbar navbar-expand-sm navbar-toggleable-sm custom-navbar box-shadow mb-3">
        <div class="container-fluid px-4">
            <a class="navbar-brand" asp-controller="Home" asp-action="Index">
                <img src="~/img/logo.png" alt="HardReserve" class="header-logo-img" > HardReserve
            </a>
            <button class="navbar-toggler text-light" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
            aria-expanded="false" aria-label="Toggle navigation" style="border-color: rgba(0,255,204,0.3)">
            <span class="navbar-toggler-icon" style="filter: invert(1);"></span>
        </button>
        <div class="navbar-collapse collapse d-sm-inline-flex justify-content-end">
            <ul class="navbar-nav gap-4">
                <li class="nav-item">
                    <a class="nav-link active-capsule" asp-controller="Home" asp-action="Index">Home</a>
                </li>
                <li class="nav-item">
                    <a class="nav-link" asp-controller="Hardware" asp-action="Index">Catálogo</a>
                </li>
                @if (estaLogado)
                {
                    <li class="nav-item">
                        <a class="nav-link" asp-controller="Reserva" asp-action="Listagem">Reservas</a>
                    </li>
                }
                @if (ehTecnico)
                {
                    <li class="nav-item">
                        <a class="nav-link" asp-controller="Hardware" asp-action="Cadastrar">Cadastrar</a>
                    </li>
                }
                @if (estaLogado)
                {
                    <li class="nav-item">
                        <a class="nav-link" asp-controller="Usuario" asp-action="Sair">Sair</a>
                    </li>
                }
                else
                {
                    <li class="nav-item">
                        <a class="nav-link" asp-controller="Login" asp-action="Index">Login</a>
                    </li>
                }
            </ul>
        </div>
    </div>
</nav>
</header>

        <main>
            @RenderBody()
        </main>

<footer class="custom-footer pt-5 pb-4 mt-5">
        <div class="container px-4">
            <div class="row gy-4">

                <div class="col-md-5 d-flex flex-column gap-3">
                    <div class="d-flex align-items-center gap-2 text-white fs-4 fw-bold" style="font-family: 'Orbitron';">
                        <img src="~/img/logo.png" alt="HardReserve" class="footer-logo-laptop-img"> HardReserve
                    </div>
                    <div>
                        <img src="~/img/logo-senai.png" alt="SENAI" class="logo-senai-img" />
                    </div>
                    <div class="text-white mt-2 fw-semibold">
                        /hardreserve
                    </div>
                </div>

                <div class="col-md-4">
                    <h5 class="footer-heading">HardReserve</h5>
                    <ul class="list-unstyled d-flex flex-column gap-2">
                        <li><a href="#">Baixar aplicativo</a></li>
                        <li><a href="#">Suporte ao Usuário</a></li>
                        <li class="mt-2">
                            <span class="d-block fw-semibold mb-2" style="color: #00ffcc !important;">Siga nas redes sociais</span>
                            <div class="social-icons">
                                <a href="#"><i class="bi bi-instagram"></i></a>
                                <a href="#"><i class="bi bi-facebook"></i></a>
                                <a href="#"><i class="bi bi-whatsapp"></i></a>
                            </div>
                        </li>
                    </ul>
                </div>

                <div class="col-md-3">
                    <h5 class="footer-heading">Quem somos</h5>
                    <ul class="list-unstyled d-flex flex-column gap-2">
                        <li><a href="#">Clientes</a></li>
                        <li><a href="#">Benefícios</a></li>
                    </ul>
                </div>

            </div>

            <hr class="mt-4 mb-3" style="border-color: rgba(255,255,255,0.15);">

            <div class="d-flex flex-column flex-md-row justify-content-end align-items-center footer-bottom-links gap-2">
                <span class="text-muted me-auto small">&copy; 2026 - HardReserve</span>
                <a href="#">Acessibilidade</a>
                <a href="#">Política de privacidade</a>
                <a href="#">Termos de condições</a>
            </div>
        </div>
</footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script>
        window.SwalCyber = Swal.mixin({
            background: '#0a1a18',
            color: '#ffffff',
            confirmButtonColor: '#00cc99',
            cancelButtonColor: '#ff6b6b',
            customClass: {
                popup: 'swal-cyber-popup',
                title: 'swal-cyber-title',
                htmlContainer: 'swal-cyber-text',
                confirmButton: 'swal-cyber-btn',
                cancelButton: 'swal-cyber-btn'
            }
        });

        window.ToastCyber = Swal.mixin({
            toast: true,
            position: 'top-end',
            showConfirmButton: false,
            timer: 4000,
            timerProgressBar: true,
            background: '#0a1a18',
            color: '#ffffff',
            customClass: { popup: 'swal-cyber-popup' }
        });
    </script>
    @if (TempData["Sucesso"] != null)
    {
        <script>
            ToastCyber.fire({ icon: 'success', title: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(TempData["Sucesso"]?.ToString())) });
        </script>
    }
    @if (TempData["Erro"] != null)
    {
        <script>
            ToastCyber.fire({ icon: 'error', title: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(TempData["Erro"]?.ToString())) });
        </script>
    }
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
